meta {
  name: Create a new user
  type: http
  seq: 1
}

post {
  url: {{BACKEND_URL}}/api/users/register
  body: json
  auth: inherit
}

body:json {
  {
      "name": "User 01",
      "email": "usertest01@mail.com",
      "password": "usertest01"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
